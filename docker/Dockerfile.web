FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
# Sitemap/robots/OG build anında üretildiği için kanonik adres build arg olmalı.
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @xenior/types build
RUN pnpm --filter @xenior/config build
RUN pnpm --filter @xenior/validation build
RUN pnpm --filter @xenior/ui build
RUN pnpm --filter @xenior/web build

# Runtime yalnızca standalone çıktısını taşır: minimal node_modules +
# statik dosyalar + public. Tam node_modules/packages kopyalanmaz.
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
RUN addgroup -S xenior && adduser -S xenior -G xenior
COPY --from=build --chown=xenior:xenior /app/apps/web/.next/standalone ./
COPY --from=build --chown=xenior:xenior /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=xenior:xenior /app/apps/web/public ./apps/web/public
USER xenior
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
