NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://xenior:replace-with-a-local-development-password@localhost:5432/xenior
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_MERCHANT_ID=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Notification providers. Tenant panel credentials override these platform defaults.
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=
# NETGSM_BASE_URL=https://api.netgsm.com.tr
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# CREDENTIALS_ENCRYPTION_KEY=
# SENTRY_DSN=
# ALLOW_MOCK_NOTIFICATIONS=false

# Object storage. Local disk is the development default; production must use s3.
STORAGE_DRIVER=local
