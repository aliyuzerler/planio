{
  "name": "xenior",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @xenior/web dev",
    "dev:admin": "pnpm --filter @xenior/admin dev",
    "dev:api": "pnpm --filter @xenior/api start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api:e2e": "pnpm --filter @xenior/api test:e2e",
    "db:format": "pnpm --filter @xenior/database format",
    "db:generate": "pnpm --filter @xenior/database generate",
    "db:validate": "pnpm --filter @xenior/database validate",
    "db:migrate": "pnpm --filter @xenior/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @xenior/database migrate:deploy",
    "db:migrate:status": "pnpm --filter @xenior/database migrate:status"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
