FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @xenior/types build
RUN pnpm --filter @xenior/config build
RUN pnpm --filter @xenior/validation build
RUN pnpm --filter @xenior/ui build
RUN pnpm --filter @xenior/web build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S xenior && adduser -S xenior -G xenior
COPY --from=build --chown=xenior:xenior /app/package.json ./package.json
COPY --from=build --chown=xenior:xenior /app/node_modules ./node_modules
COPY --from=build --chown=xenior:xenior /app/packages ./packages
COPY --from=build --chown=xenior:xenior /app/apps/web ./apps/web
USER xenior
EXPOSE 3000
CMD ["pnpm", "--filter", "@xenior/web", "start"]
