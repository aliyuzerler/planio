# Üretim ortam değişkenleri şablonu.
# Kopyalayın: cp .env.production.example .env.production  (git tarafından yok sayılır)
# Tüm değerleri doldurun; API açılışta bu şemayı doğrular ve eksik/geçersiz
# değer varsa başlamayı reddeder. Yeni anahtar üretimi:
#   openssl rand -base64 48
#
# Çalıştırma (docker/ dizininden):
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d

NODE_ENV=production

# --- Alan adları (nginx yönlendirmesi + CORS + build args) ---
WEB_DOMAIN=planio.com
ADMIN_DOMAIN=admin.planio.com
API_DOMAIN=api.planio.com
WEB_URL=https://planio.com
ADMIN_URL=https://admin.planio.com
API_URL=https://api.planio.com
NEXT_PUBLIC_API_URL=https://api.planio.com/api/v1
# Sitemap/robots/OG için kanonik site adresi (web uygulamasının kendi adresi).
NEXT_PUBLIC_SITE_URL=https://planio.com

# --- Veritabanı (compose içindeki postgres; harici DB için URL'u değiştirin) ---
POSTGRES_USER=xenior
POSTGRES_PASSWORD=uret-uzun-bir-sifre
POSTGRES_DB=xenior
# Bağlantı havuzu: tek API örneği için 10-20 arası yeterli.
DATABASE_URL=postgresql://xenior:uret-uzun-bir-sifre@postgres:5432/xenior?connection_limit=15
REDIS_URL=redis://redis:6379

# --- Oturum anahtarları (biri diğerinin aynısı OLMAMALI, >=32 karakter) ---
JWT_SECRET=uret-rastgele-48-byte
JWT_REFRESH_SECRET=uret-baska-rastgele-48-byte
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Tenant sağlayıcı şifrelerinin şifreleme anahtarı (JWT'lerden farklı) ---
CREDENTIALS_ENCRYPTION_KEY=uret-ucuncu-rastgele-48-byte

# --- iyzico (zorunlu; canlı için https://api.iyzipay.com) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_BASE_URL=https://api.iyzipay.com

# --- Bildirim sağlayıcıları (isteğe bağlı; boş bırakılırsa mock/dev dışı davranış) ---
# NetGSM SMS
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
# Meta WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Gmail SMTP (Google Hesabı -> Güvenlik -> 2 adımlı doğrulama -> Uygulama şifreleri)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# FCM push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Nesne depolama (production'da s3 zorunlu) ---
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- İzleme (henüz entegre değil; lansman sonrası) ---
# SENTRY_DSN=

# API bağlantı noktası (kapsayıcı içi)
API_PORT=3001
