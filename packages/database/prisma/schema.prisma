generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum BusinessUserRole {
  BUSINESS_OWNER
  BUSINESS_ADMIN
  STAFF
  ACCOUNTANT
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BillingPeriod {
  MONTHLY
  SEMIANNUAL
  YEARLY
}

enum CustomerFileKind {
  KVKK
  SIGNED_FORM
  OTHER
}

enum CampaignDiscountType {
  PERCENT
  AMOUNT
}

enum CommissionType {
  PERCENT
  AMOUNT
}

enum CommissionSourceType {
  APPOINTMENT
}

enum CashAccountType {
  CASH
  BANK
}

enum SaleSource {
  APPOINTMENT
  COUNTER
}

enum SaleStatus {
  OPEN
  SETTLED
}

enum CollectionMethod {
  CASH
  CARD
  LINK
}

enum AppointmentPaymentPlan {
  DEPOSIT
  FULL
  ON_DAY
}

enum AppointmentPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TenantPosProvider {
  GENERIC
  IYZICO
}

enum CheckoutPurpose {
  DEPOSIT
  FULL
  REMAINING
}

enum CheckoutIntentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum OfficialDocumentType {
  E_FATURA
  SMM
}

enum OfficialDocumentStatus {
  PENDING
  ISSUED
  FAILED
}

enum UyumsoftProvider {
  GENERIC
  UYUMSOFT
}

enum ExpenseCategory {
  RENT
  UTILITY
  MATERIAL
  SALARY
  COMMISSION
  OTHER
}

enum LedgerEntryType {
  SALE
  COLLECTION
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  IYZICO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  SUBSCRIPTION
  CUSTOM
}

enum NotificationChannel {
  SMS
  WHATSAPP
  PUSH
  EMAIL
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  STAFF_INVITE
}

enum DataRequestType {
  EXPORT
  ERASE
}

enum DataRequestStatus {
  PENDING
  COMPLETED
}

enum NotificationStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(320)
  passwordHash String?      @db.VarChar(255)
  firstName    String?      @db.VarChar(100)
  lastName     String?      @db.VarChar(100)
  platformRole PlatformRole @default(USER)
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  businessUsers BusinessUser[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  pushDevices   PushDevice[]
  authTokens    AuthToken[]
  dataRequests  DataRequest[]
  privacyConsents PrivacyConsent[]

  @@index([platformRole, isActive])
}

model Business {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(200)
  phone     String?        @db.VarChar(32)
  email     String?        @db.VarChar(320)
  address   String?        @db.Text
  timezone  String         @default("Europe/Istanbul") @db.VarChar(64)
  currency  String         @default("TRY") @db.Char(3)
  status                 BusinessStatus @default(ACTIVE)
  hoursEnforced          Boolean        @default(false)
  privacyPolicyAcceptedAt DateTime?     @db.Timestamptz(3)
  receiptSequence             Int            @default(0)
  officialDocumentSequence    Int            @default(0)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  users                   BusinessUser[]
  staff                   Staff[]
  specializations         Specialization[]
  customers               Customer[]
  customerFiles           CustomerFile[]
  services                Service[]
  campaigns               Campaign[]
  commissionRules         CommissionRule[]
  commissionEntries       CommissionEntry[]
  cashAccounts            CashAccount[]
  sales                   Sale[]
  saleLines               SaleLine[]
  collections             Collection[]
  expenses                Expense[]
  ledgerEntries           CustomerLedgerEntry[]
  salesReceipts           SalesReceipt[]
  officialDocuments       OfficialDocument[]
  tenantUyumsoftSettings  TenantUyumsoftSettings?
  resources               Resource[]
  appointments            Appointment[]
  appointmentEvents       AppointmentEvent[]
  subscriptions           Subscription[]
  payments                Payment[]
  notificationTemplates   NotificationTemplate[]
  notifications           Notification[]
  notificationSettings    NotificationSettings?
  notificationChannels    NotificationChannelConfig[]
  pushDevices             PushDevice[]
  businessHours           BusinessHours[]
  staffHours              StaffHours[]
  privacyConsents         PrivacyConsent[]
  dataRequests            DataRequest[]
  authTokens              AuthToken[]
  auditLogs               AuditLog[]
  tenantPaymentSettings   TenantPaymentSettings?
  checkoutIntents         CheckoutIntent[]

  @@index([status])
}

model BusinessUser {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @db.Uuid
  userId     String           @db.Uuid
  role       BusinessUserRole
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  staffProfile      Staff?
  appointmentsMade  Appointment[]      @relation("AppointmentCreator")
  appointmentEvents AppointmentEvent[] @relation("AppointmentEventActor")
  salesCreated      Sale[]             @relation("SaleCreator")
  collectionsMade   Collection[]       @relation("CollectionCollector")
  expensesCreated   Expense[]          @relation("ExpenseCreator")
  receiptsIssued    SalesReceipt[]     @relation("ReceiptIssuer")
  officialDocumentsIssued OfficialDocument[] @relation("OfficialDocumentIssuer")
  notifications     Notification[]     @relation("NotificationUserRecipient")

  @@unique([businessId, userId])
  @@unique([businessId, id])
  @@index([userId, isActive])
  @@index([businessId, role, isActive])
}

model Staff {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  businessUserId String?  @db.Uuid
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  phone          String?  @db.VarChar(32)
  email          String?  @db.VarChar(320)
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessUser    BusinessUser?         @relation(fields: [businessId, businessUserId], references: [businessId, id], onDelete: Restrict)
  specializations StaffSpecialization[]
  appointments    Appointment[]
  hours           StaffHours[]
  commissionEntries CommissionEntry[]
  sales           Sale[]
  expenses        Expense[]
  notifications   Notification[]        @relation("NotificationStaffRecipient")

  @@unique([businessId, id])
  @@unique([businessId, businessUserId])
  @@index([businessId, isActive])
  @@index([businessId, lastName, firstName])
  @@index([businessId, phone])
}

model Specialization {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String   @db.VarChar(120)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staff    StaffSpecialization[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, isActive])
}

model StaffSpecialization {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @db.Uuid
  staffId          String   @db.Uuid
  specializationId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  staff          Staff          @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  specialization Specialization @relation(fields: [businessId, specializationId], references: [businessId, id], onDelete: Cascade)

  @@unique([staffId, specializationId])
  @@index([businessId, specializationId])
}

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  firstName  String    @db.VarChar(100)
  lastName   String    @db.VarChar(100)
  phone      String?   @db.VarChar(32)
  email      String?   @db.VarChar(320)
  birthDate  DateTime? @db.Date
  notes            String?  @db.Text
  smsConsent       Boolean  @default(true)
  whatsappConsent  Boolean  @default(true)
  emailConsent     Boolean  @default(true)
  ledgerBalance    Decimal  @default(0) @db.Decimal(12, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointments  Appointment[]
  sales         Sale[]
  collections   Collection[]
  ledgerEntries CustomerLedgerEntry[]
  notifications Notification[]        @relation("NotificationCustomerRecipient")
  files           CustomerFile[]
  checkoutIntents CheckoutIntent[]

  @@unique([businessId, id])
  @@index([businessId, isActive])
  @@index([businessId, lastName, firstName])
  @@index([businessId, phone])
  @@index([businessId, email])
}

model CustomerFile {
  id               String           @id @default(uuid()) @db.Uuid
  businessId       String           @db.Uuid
  customerId       String           @db.Uuid
  kind             CustomerFileKind
  originalName     String           @db.VarChar(255)
  contentType      String           @db.VarChar(120)
  sizeBytes        Int
  storageKey       String           @db.VarChar(500)
  uploadedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, customerId, createdAt])
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  name            String   @db.VarChar(160)
  description     String?  @db.Text
  durationMinutes Int
  price           Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointments     Appointment[]
  campaignServices CampaignService[]
  commissionRules  CommissionRule[]
  saleLines        SaleLine[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, isActive])
}

model Resource {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String   @db.VarChar(120)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, isActive])
}

model Appointment {
  id                      String            @id @default(uuid()) @db.Uuid
  businessId              String            @db.Uuid
  customerId              String            @db.Uuid
  staffId                 String            @db.Uuid
  serviceId               String            @db.Uuid
  resourceId              String?           @db.Uuid
  createdByUserId         String            @db.Uuid
  startAt                 DateTime          @db.Timestamptz(3)
  endAt                   DateTime          @db.Timestamptz(3)
  status                  AppointmentStatus @default(CONFIRMED)
  notes                   String?           @db.Text
  serviceNameSnapshot     String            @db.VarChar(160)
  serviceDurationSnapshot Int
  servicePriceSnapshot    Decimal           @db.Decimal(12, 2)
  listPriceSnapshot       Decimal           @db.Decimal(12, 2)
  discountAmountSnapshot  Decimal           @default(0) @db.Decimal(12, 2)
  campaignId              String?           @db.Uuid
  campaignNameSnapshot    String?           @db.VarChar(160)
  currency                String            @db.Char(3)
  paymentPlan             AppointmentPaymentPlan   @default(ON_DAY)
  depositAmount           Decimal?                 @db.Decimal(12, 2)
  paymentStatus           AppointmentPaymentStatus @default(UNPAID)
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaign  Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customer  Customer           @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  staff     Staff              @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  service   Service            @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  resource  Resource?          @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  createdBy BusinessUser       @relation("AppointmentCreator", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  events           AppointmentEvent[]
  notifications    Notification[]
  commissionEntry  CommissionEntry?
  sale             Sale?
  checkoutIntents  CheckoutIntent[]

  @@unique([businessId, id])
  @@index([businessId, startAt])
  @@index([businessId, staffId, startAt])
  @@index([businessId, customerId, startAt])
  @@index([businessId, resourceId, startAt])
  @@index([businessId, status, startAt])
  @@index([campaignId])
}

model Campaign {
  id            String                @id @default(uuid()) @db.Uuid
  businessId    String                @db.Uuid
  name          String                @db.VarChar(160)
  discountType  CampaignDiscountType
  discountValue Decimal               @db.Decimal(12, 2)
  startsAt      DateTime              @db.Timestamptz(3)
  endsAt        DateTime              @db.Timestamptz(3)
  isActive      Boolean               @default(true)
  smsTemplate   String?               @db.Text
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  services     CampaignService[]
  appointments Appointment[]
  sales        Sale[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, isActive, startsAt, endsAt])
}

model CommissionRule {
  id               String         @id @default(uuid()) @db.Uuid
  businessId       String         @db.Uuid
  name             String         @db.VarChar(160)
  serviceId        String?        @db.Uuid
  commissionType   CommissionType
  commissionValue  Decimal        @db.Decimal(12, 2)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service  Service?          @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  entries  CommissionEntry[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, isActive, serviceId])
}

model CommissionEntry {
  id                   String               @id @default(uuid()) @db.Uuid
  businessId           String               @db.Uuid
  staffId              String               @db.Uuid
  appointmentId        String?              @db.Uuid
  ruleId               String?              @db.Uuid
  sourceType           CommissionSourceType
  sourceId             String               @db.Uuid
  staffNameSnapshot    String               @db.VarChar(200)
  serviceNameSnapshot  String               @db.VarChar(160)
  ruleNameSnapshot     String               @db.VarChar(160)
  basisAmount          Decimal              @db.Decimal(12, 2)
  commissionType       CommissionType
  commissionValue      Decimal              @db.Decimal(12, 2)
  amount               Decimal              @db.Decimal(12, 2)
  currency             String               @db.Char(3)
  earnedAt             DateTime             @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staff       Staff           @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  appointment Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  rule        CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  payoutExpense Expense?

  @@unique([businessId, sourceType, sourceId])
  @@unique([appointmentId])
  @@index([businessId, staffId, earnedAt])
}

model CashAccount {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String          @db.Uuid
  name       String          @db.VarChar(120)
  type       CashAccountType
  currency   String          @db.Char(3)
  isDefault  Boolean         @default(false)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  collections Collection[]
  expenses    Expense[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, isActive])
}

model Sale {
  id                     String     @id @default(uuid()) @db.Uuid
  businessId             String     @db.Uuid
  customerId             String     @db.Uuid
  appointmentId          String?    @unique @db.Uuid
  staffId                String?    @db.Uuid
  createdByUserId        String     @db.Uuid
  source                 SaleSource
  status                 SaleStatus @default(OPEN)
  currency               String     @db.Char(3)
  totalAmount            Decimal    @db.Decimal(12, 2)
  collectedAmount        Decimal    @default(0) @db.Decimal(12, 2)
  listPriceSnapshot      Decimal    @db.Decimal(12, 2)
  discountAmountSnapshot Decimal    @default(0) @db.Decimal(12, 2)
  campaignId             String?    @db.Uuid
  campaignNameSnapshot   String?    @db.VarChar(160)
  notes                  String?    @db.Text
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer    Customer           @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  staff       Staff?             @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  campaign    Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy   BusinessUser       @relation("SaleCreator", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  lines       SaleLine[]
  collections Collection[]
  receipt           SalesReceipt?
  officialDocument  OfficialDocument?
  ledgerEntries     CustomerLedgerEntry[]
  checkoutIntents   CheckoutIntent[]

  @@unique([businessId, id])
  @@index([businessId, createdAt])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, staffId, createdAt])
  @@index([businessId, status])
  @@index([campaignId])
}

model SaleLine {
  id                     String  @id @default(uuid()) @db.Uuid
  businessId             String  @db.Uuid
  saleId                 String  @db.Uuid
  serviceId              String? @db.Uuid
  nameSnapshot           String  @db.VarChar(160)
  quantity               Int     @default(1)
  unitPrice              Decimal @db.Decimal(12, 2)
  lineTotal              Decimal @db.Decimal(12, 2)
  listPriceSnapshot      Decimal @db.Decimal(12, 2)
  discountAmountSnapshot Decimal @default(0) @db.Decimal(12, 2)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, saleId])
}

model Collection {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  saleId          String           @db.Uuid
  cashAccountId   String           @db.Uuid
  customerId      String           @db.Uuid
  collectedByUserId String         @db.Uuid
  amount          Decimal          @db.Decimal(12, 2)
  method          CollectionMethod @default(CASH)
  notes           String?          @db.Text
  collectedAt     DateTime         @default(now()) @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  cashAccount CashAccount  @relation(fields: [businessId, cashAccountId], references: [businessId, id], onDelete: Restrict)
  customer    Customer     @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  collectedBy     BusinessUser     @relation("CollectionCollector", fields: [businessId, collectedByUserId], references: [businessId, userId], onDelete: Restrict)
  ledgerEntries   CustomerLedgerEntry[]
  checkoutIntent  CheckoutIntent?

  @@index([businessId, collectedAt])
  @@index([businessId, saleId])
  @@index([businessId, cashAccountId, collectedAt])
}

model CustomerLedgerEntry {
  id           String          @id @default(uuid()) @db.Uuid
  businessId   String          @db.Uuid
  customerId   String          @db.Uuid
  saleId       String?         @db.Uuid
  collectionId String?         @db.Uuid
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  description  String          @db.VarChar(240)
  occurredAt   DateTime        @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer   Customer    @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@index([businessId, customerId, occurredAt])
  @@index([businessId, occurredAt])
}

model Expense {
  id                String          @id @default(uuid()) @db.Uuid
  businessId        String          @db.Uuid
  cashAccountId     String          @db.Uuid
  createdByUserId   String          @db.Uuid
  staffId           String?         @db.Uuid
  commissionEntryId String?         @unique @db.Uuid
  category          ExpenseCategory
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @db.Char(3)
  notes             String?         @db.Text
  occurredAt        DateTime        @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cashAccount     CashAccount      @relation(fields: [businessId, cashAccountId], references: [businessId, id], onDelete: Restrict)
  createdBy       BusinessUser     @relation("ExpenseCreator", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  staff           Staff?           @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  commissionEntry CommissionEntry? @relation(fields: [commissionEntryId], references: [id], onDelete: Restrict)

  @@index([businessId, occurredAt])
  @@index([businessId, category, occurredAt])
}

model SalesReceipt {
