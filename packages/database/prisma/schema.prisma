model NotificationTemplate {
  id         String              @id @default(uuid()) @db.Uuid
  businessId String              @db.Uuid
  name       String              @db.VarChar(120)
  type       NotificationType
  channel    NotificationChannel
  subject    String?             @db.VarChar(200)
  body       String              @db.Text
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([businessId, name, channel])
  @@unique([businessId, id])
  @@index([businessId, type, channel, isActive])
}

model Notification {
  id                  String              @id @default(uuid()) @db.Uuid
  businessId          String              @db.Uuid
  templateId          String?             @db.Uuid
  recipientCustomerId String?             @db.Uuid
  recipientStaffId    String?             @db.Uuid
  recipientUserId     String?             @db.Uuid
  appointmentId       String?             @db.Uuid
  type                NotificationType
  channel             NotificationChannel
  status              NotificationStatus  @default(PENDING)
  destination         String?             @db.VarChar(320)
  subject             String?             @db.VarChar(200)
  body                String              @db.Text
  payload             Json?
  provider            String?             @db.VarChar(40)
  attemptCount        Int                 @default(0)
  scheduledAt         DateTime?           @db.Timestamptz(3)
  sentAt              DateTime?           @db.Timestamptz(3)
  lastAttemptAt       DateTime?           @db.Timestamptz(3)
  errorCode           String?             @db.VarChar(100)
  errorMessage        String?             @db.Text
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)

  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  template          NotificationTemplate? @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  appointment       Appointment?          @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  recipientCustomer Customer?             @relation("NotificationCustomerRecipient", fields: [businessId, recipientCustomerId], references: [businessId, id], onDelete: Restrict)
  recipientStaff    Staff?                @relation("NotificationStaffRecipient", fields: [businessId, recipientStaffId], references: [businessId, id], onDelete: Restrict)
  recipientUser     BusinessUser?         @relation("NotificationUserRecipient", fields: [businessId, recipientUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, status, scheduledAt])
  @@index([businessId, appointmentId, type, status])
  @@index([businessId, recipientCustomerId, createdAt])
  @@index([businessId, recipientStaffId, createdAt])
  @@index([businessId, recipientUserId, createdAt])
}

model NotificationChannelConfig {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  channel            NotificationChannel
  provider           String              @db.VarChar(40)
