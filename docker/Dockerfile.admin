FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/admin ./apps/admin
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @xenior/types build
RUN pnpm --filter @xenior/config build
RUN pnpm --filter @xenior/validation build
RUN pnpm --filter @xenior/ui build
RUN pnpm --filter @xenior/admin build

# Runtime yalnızca standalone çıktısını taşır: minimal node_modules +
# statik dosyalar + public. Tam node_modules/packages kopyalanmaz.
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3002
RUN addgroup -S xenior && adduser -S xenior -G xenior
COPY --from=build --chown=xenior:xenior /app/apps/admin/.next/standalone ./
COPY --from=build --chown=xenior:xenior /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build --chown=xenior:xenior /app/apps/admin/public ./apps/admin/public
USER xenior
EXPOSE 3002
CMD ["node", "apps/admin/server.js"]
