  currency      String        @default("TRY") @db.Char(3)
  isActive      Boolean       @default(true)
  limits                  Json?
  externalPricingPlanCode String?       @db.VarChar(191)
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@unique([name, billingPeriod, currency])
  @@index([isActive])
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  businessId             String             @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus
  startedAt              DateTime           @db.Timestamptz(3)
  currentPeriodStart     DateTime           @db.Timestamptz(3)
  currentPeriodEnd       DateTime           @db.Timestamptz(3)
  cancelledAt            DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  externalProvider       PaymentProvider?
  externalCustomerId     String?            @db.VarChar(191)
  externalSubscriptionId String?            @db.VarChar(191)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([businessId, id])
  @@unique([externalProvider, externalSubscriptionId])
  @@index([businessId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  businessId        String          @db.Uuid
  subscriptionId    String          @db.Uuid
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @db.Char(3)
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  externalPaymentId String?         @db.VarChar(191)
  externalReference String?         @db.VarChar(191)
  paidAt            DateTime?       @db.Timestamptz(3)
  failedAt          DateTime?       @db.Timestamptz(3)
  errorCode         String?         @db.VarChar(100)
  errorMessage      String?         @db.Text
  metadata          Json?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [businessId, subscriptionId], references: [businessId, id], onDelete: Restrict)

  @@unique([provider, externalPaymentId])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([subscriptionId])
  @@index([externalReference])
}

