model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  revokedReason     String?   @db.VarChar(64)
  replacedByTokenId String?   @unique @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}
