# Shared local development defaults.
# Copy to `.env` in each application that needs these values.
# Never commit real credentials.

NODE_ENV=development

POSTGRES_USER=xenior
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=xenior
DATABASE_URL=postgresql://xenior:replace-with-a-local-development-password@localhost:5432/xenior
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

API_PORT=3001

# Optional iyzico sandbox. Leave keys empty to use the local mock provider.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_MERCHANT_ID=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=
# SMTP_HOST=
# SMTP_FROM=
# SENTRY_DSN=

# Object storage. Local disk is the development default; production must use s3.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage
# STORAGE_ENDPOINT=
# STORAGE_REGION=eu-central-1
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_FORCE_PATH_STYLE=true
