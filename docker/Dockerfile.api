FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @xenior/database generate
RUN pnpm --filter @xenior/types build
RUN pnpm --filter @xenior/config build
RUN pnpm --filter @xenior/validation build
RUN pnpm --filter @xenior/api build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S xenior && adduser -S xenior -G xenior
COPY --from=build --chown=xenior:xenior /app/package.json ./package.json
COPY --from=build --chown=xenior:xenior /app/node_modules ./node_modules
COPY --from=build --chown=xenior:xenior /app/packages ./packages
COPY --from=build --chown=xenior:xenior /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=xenior:xenior /app/apps/api/dist ./apps/api/dist
USER xenior
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
